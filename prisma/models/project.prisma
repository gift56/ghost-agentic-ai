enum ProjectStatus {
  DRAFT
  ARCHIVED
}

model Project {
  id                 String                @id @default(cuid())
  ownerId            String
  name               String
  description        String?
  status             ProjectStatus         @default(DRAFT)
  /// Vercel Blob URL for persisted canvas JSON (`{ nodes, edges }`); private-store blobs are read via the Blob SDK on the server.
  canvasJsonPath     String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  collaborators      ProjectCollaborator[]
  specs              ProjectSpec[]

  @@index([ownerId])
  @@index([createdAt])
}

/// Metadata for a generated architecture spec; Markdown bytes live in Vercel Blob at `filePath`.
model ProjectSpec {
  id        String   @id @default(cuid())
  projectId String
  /// Vercel Blob URL for the Markdown document; private blobs are read via the Blob SDK on the server.
  filePath  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
}

model ProjectCollaborator {
  id                String   @id @default(cuid())
  projectId         String
  email             String
  createdAt         DateTime @default(now())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
